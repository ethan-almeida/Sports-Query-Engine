# sportsql local dev configuration. Copy to .env and edit.

# Postgres (docker compose + `make migrate`)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sports

# API server
LISTEN_ADDR=:8080
LOG_LEVEL=INFO

# LLM (Groq, OpenAI-compatible). Model names are whatever your plan offers,
# e.g. llama-3.3-70b-versatile. SQL and answer may use different models.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL_SQL=
LLM_MODEL_ANSWER=

# Databases (dev passwords match migrations/0002_roles.sql)
DATABASE_URL_RO=postgres://api_ro:api_ro@localhost:5432/sports
DATABASE_URL_RW=postgres://ingest_rw:ingest_rw@localhost:5432/sports

# Redis
REDIS_URL=redis://localhost:6379/0

# ESPN base URLs (optional; defaults are site.api.espn.com / sports.core.api.espn.com)
# ESPN_BASE_URL=
# ESPN_CORE_BASE_URL=
