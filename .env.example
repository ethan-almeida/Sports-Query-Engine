POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sports

# API server
LISTEN_ADDR=:8080
LOG_LEVEL=INFO

LLM_BASE_URL=https://api.groq.com/openai/v1 #can change this to your LLM provider
LLM_API_KEY=
LLM_MODEL_SQL=
LLM_MODEL_ANSWER=

# Databases (dev passwords match migrations/0002_roles.sql)
DATABASE_URL_RO=postgres://api_ro:api_ro@localhost:5432/sports
DATABASE_URL_RW=postgres://ingest_rw:ingest_rw@localhost:5432/sports

# Redis
REDIS_URL=redis://localhost:6379/0

# ESPN base URL (optional; default shown)
# ESPN_BASE_URL=    # JSON scoreboard + summary API (default https://site.api.espn.com)
